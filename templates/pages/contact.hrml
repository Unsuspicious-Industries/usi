<?block slot="head"?><?title value="Contact · USI"?><?meta name="description" content="Email or a 15-minute call. Based in Paris."?><?og name="title" content="Contact · Unsuspicious Industries"?><?og name="description" content="Email or a 15-minute call. Based in Paris."?><?/block?>
<?block slot="content"?>
<?style?>
main {
    background-image: url('/static/images/catacombs-contact.webp');
    background-size: cover;
    background-position: top center;
    background-repeat: no-repeat;
}
main .hero { background: transparent; }
main .hero::before { display: none; }
.contact { max-width: 56rem; margin: 0 auto; padding: 1rem 2rem 6rem; }
.contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
.contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem 1.75rem 1.75rem;
    background: var(--bg-page);
    border: 1px solid var(--border);
    border-top: 6px solid var(--accent);
}
.contact-card svg { width: 1.75rem; height: 1.75rem; color: var(--accent); }
.contact-card h2 { font-family: var(--font-serif); font-size: 1.5rem; line-height: 1.2; margin: 0; color: var(--text-heading); }
.contact-card p { margin: 0; color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; flex: 1; }
.contact-card .btn { align-self: flex-start; max-width: 100%; margin-top: 0.5rem; overflow-wrap: anywhere; }
.contact-notes {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--text-muted);
    position: relative;
    isolation: isolate;
}
/* A soft field under the line, as under the headings: the page ground is a map. */
.contact-notes::before {
    content: '';
    position: absolute;
    inset: -1rem -4rem -1rem -4rem;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(60% 90% at 50% 50%, var(--bg-page) 0%, var(--bg-page) 50%, transparent 100%);
    filter: blur(14px);
}
@media (max-width: 768px) {
    .contact { padding: 1rem 1rem 3rem; }
    .contact-grid { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
}
<?/style?>

<?use id="hero-cmp"?>
    <?label?>Contact<?/label?>
    <?title?>Write, or <accent>talk</accent>.<?/title?>
<?/use?>

<section class="contact">
    <div class="contact-grid">
        <article class="contact-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <h2>Email</h2>
            <p>Questions, collaborations and corrections.</p>
            <a class="btn btn-secondary" href="mailto:contact@unsuspicious.org">contact@unsuspicious.org</a>
        </article>
        <article class="contact-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4m-5 4h18"/></svg>
            <h2>Fifteen minutes</h2>
            <p>A short call to see whether we should work together.</p>
            <a class="btn btn-primary" href="https://cal.com/unsuspicious/15min" target="_blank" rel="noopener">Book a slot</a>
        </article>
    </div>
    <div class="contact-notes">
        <span>Paris, France.</span>
        <span>Looking for a role? <a href="/jobs">See the open positions</a>.</span>
    </div>
</section>
<?/block?>
