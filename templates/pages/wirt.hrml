<!-- Wirt owns this UI; snapshot provenance: tools/wirt-ui-source.json. -->
<?style?>
/* Corporate palette aliases; geometry/layout otherwise follows Wirt. */
main {
    --ground: var(--bg-page);
    --surface: var(--bg-section);
    --ink: var(--text-default);
    --ink-dim: var(--text-muted);
    --rule: var(--border);
}
/* Let narrow controls and long labels wrap rather than widen the page. */
.pg-row { flex-wrap: wrap; }
.pg-row > * { min-width: 7rem; }
.pg-box-head { flex-wrap: wrap; }
/* The playground's own markup. Colours are roles from the palette; a literal
   here would fail the build, which is the point of strict_colors. */
.pg-hero {
    max-width: 100rem;
    margin: 0 auto;
    padding: 4rem 2rem 1rem;
}
.pg-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-weight: 700;
    margin: 0;
}
.pg-title {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.05;
    margin: 0.5rem 0 0.75rem;
}
.pg-title .hi { color: var(--accent); }
.pg-lede {
    font-size: 1.2rem;
    color: var(--ink-dim);
    max-width: 46rem;
    margin: 0 0 1.25rem;
    line-height: 1.6;
}

/* ── The workbench ─────────────────────────────────────────────────── */
.pg-wrap { max-width: 100rem; margin: 0 auto; padding: 1rem 2rem 4rem; }
.pg-cols {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2rem;
    align-items: start;
}
.pg-box {
    border: 1px solid var(--rule);
    background: var(--ground);
}
.pg-box-head {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
}
.pg-box-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
    font-weight: 700;
}
.pg-box-note { margin: 0; font-size: 0.75rem; color: var(--ink-dim); }
.pg-box-body { padding: 1rem; }

.pg-field { margin-bottom: 0.9rem; }
.pg-field:last-child { margin-bottom: 0; }
.pg-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
    margin-bottom: 0.35rem;
    font-weight: 600;
}
.pg-input, .pg-select, .pg-area {
    width: 100%;
    box-sizing: border-box;
    padding: 0.5rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink);
    background: var(--ground);
    border: 1px solid var(--rule);
    border-radius: 0;
}
.pg-input:focus, .pg-select:focus, .pg-area:focus {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
}
.pg-area { min-height: 19rem; line-height: 1.5; resize: vertical; white-space: pre; }
.pg-row { display: flex; gap: 0.75rem; }
.pg-row > * { flex: 1; }

.pg-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1rem;
}
.pg-btn {
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    cursor: pointer;
    background: var(--ink);
    color: var(--ground);
    border: 1px solid var(--ink);
}
.pg-btn:hover:not(:disabled) { background: var(--accent); border-color: var(--accent); }
.pg-btn:disabled { opacity: 0.45; cursor: not-allowed; }
.pg-btn-ghost {
    background: var(--ground);
    color: var(--ink);
    border-color: var(--rule);
}
.pg-btn-ghost:hover:not(:disabled) { background: var(--surface); color: var(--ink); }
.pg-hint { font-size: 0.75rem; color: var(--ink-dim); margin: 0; }

/* ── Status vocabulary. Colour never carries meaning alone: every one of
      these prints its own label. ─────────────────────────────────────── */
.pg-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
    border: 1px solid currentColor;
    white-space: nowrap;
}
.pg-ok { color: var(--ok); }
.pg-warn { color: var(--warn); }
.pg-bad { color: var(--bad); }
.pg-idle { color: var(--ink-dim); }
.pg-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }

.pg-diag {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
}
.pg-diag-list {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.8rem;
    color: var(--ink-dim);
    line-height: 1.6;
}
.pg-diag-list code { font-family: var(--font-mono); color: var(--ink); }

/* ── The two arms ──────────────────────────────────────────────────── */
.pg-arms { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
.pg-arm { border: 1px solid var(--rule); }
/* The arm the demo is actually arguing for. */
.pg-arm-lead { border-color: var(--accent); }
.pg-arm-lead .pg-arm-head { border-bottom-color: var(--accent); }
.pg-arm-lead .pg-arm-name { color: var(--accent); }

.pg-think {
    margin: 0 0 0.75rem;
    border: 1px dashed var(--rule);
    background: var(--surface);
}
.pg-think summary {
    cursor: pointer;
    padding: 0.4rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-dim);
    list-style: none;
}
.pg-think summary::-webkit-details-marker { display: none; }
.pg-think summary::before { content: "▸ "; }
.pg-think[open] summary::before { content: "▾ "; }
.pg-think-body {
    margin: 0;
    padding: 0 0.6rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--ink-dim);
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 16rem;
    overflow-y: auto;
}
.pg-arm-head {
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
}
.pg-arm-name {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink);
}
.pg-arm-sub { margin: 0.15rem 0 0; font-size: 0.72rem; color: var(--ink-dim); }
.pg-arm-body { padding: 0.85rem; }
.pg-out {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink);
    background: var(--surface);
    padding: 0.75rem;
    margin: 0 0 0.75rem;
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 3.5rem;
}
.pg-out-empty { color: var(--ink-dim); font-style: italic; }

.pg-tel { width: 100%; border-collapse: collapse; font-size: 0.75rem; margin-top: 0.75rem; }
.pg-tel th, .pg-tel td {
    text-align: right;
    padding: 0.25rem 0.4rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    color: var(--ink);
}
.pg-tel th {
    color: var(--ink-dim);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}
.pg-tel td:first-child, .pg-tel th:first-child { text-align: left; }
.pg-tel-wrap { overflow-x: auto; }
.pg-cap { font-size: 0.72rem; color: var(--ink-dim); margin: 0.5rem 0 0; line-height: 1.5; }

.pg-banner {
    padding: 0.6rem 0.85rem;
    border: 1px solid currentColor;
    font-size: 0.8rem;
    margin-bottom: 1rem;
}
.pg-banner p { margin: 0; }
.pg-banner code { font-family: var(--font-mono); }

.pg-runs { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.pg-run {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    background: var(--ground);
    color: var(--ink);
    border: 1px solid var(--rule);
}
.pg-run:hover { border-color: var(--accent); color: var(--accent); }
.pg-run[aria-pressed="true"] { background: var(--ink); color: var(--ground); border-color: var(--ink); }

.pg-note { max-width: 46rem; }
.pg-note p { color: var(--ink-dim); line-height: 1.7; margin: 0 0 1rem; }
.pg-note strong { color: var(--ink); }
.pg-note code { font-family: var(--font-mono); color: var(--accent); }

@media (max-width: 1180px) {
    .pg-arms { grid-template-columns: 1fr; }
}
@media (max-width: 1000px) {
    .pg-cols { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
    .pg-hero { padding: 2rem 1rem 0.5rem; }
    .pg-wrap { padding: 1rem 1rem 2rem; }
    .pg-title { font-size: 2.25rem; }
}
<?/style?>

<header class="pg-hero">
    <p class="pg-eyebrow">Wirt · Proposition 7 playground</p>
    <h1 class="pg-title">The grammar decides what the model is <span class="hi">allowed to say</span></h1>
    <p class="pg-lede">Three decodes of the same prompt, same model, same seed. One runs free.
    One may only emit tokens that keep a partial syntax tree well-formed and
    well-typed. The third reasons freely, then writes its answer under the
    grammar. All three are handed to the same engine, which says whether what
    came out actually parses and typechecks.</p>
</header>

<div class="pg-wrap">
    <div class="pg-banner pg-idle">
        <p><strong>Source preview, not live backend qualification.</strong> The recording below is static and free to view. Live use requires a qualified same-origin API; preparing this page does not establish that it is deployed.</p>
    </div>
    <div class="pg-actions" style="margin-bottom: 1rem;">
        <button class="pg-btn pg-btn-ghost" id="pg-local-replay" type="button" data-fixture="/static/wirt/c-addition-qwen3.5-0.8b.json" aria-describedby="pg-local-note">Replay recorded C addition — no GPU</button>
        <p class="pg-hint" id="pg-local-note">Real Wirt recording, qwen3.5-0.8b. All three answers are shown, including the mixed arm’s forced reasoning closure. This is not a new measurement.</p>
    </div>
    <div class="pg-actions" style="margin-bottom: 1rem;">
        <button class="pg-btn" id="pg-connect" type="button" aria-describedby="pg-connect-note">Connect / start GPU</button>
        <p class="pg-hint" id="pg-connect-note">Connecting can wake a metered GPU. This page and grammar edits make no API requests. A cold start can take several minutes.</p>
    </div>
    <div class="pg-banner pg-idle" id="pg-capability" role="status" aria-live="polite" hidden></div>

    <div class="pg-cols">
        <div class="pg-box">
            <div class="pg-box-head">
                <h2 class="pg-box-title">Grammar</h2>
                <p class="pg-box-note" id="pg-grammar-note">connect to load library</p>
            </div>
            <div class="pg-box-body">
                <div class="pg-field">
                    <label class="pg-label" for="pg-grammar">From the library</label>
                    <select class="pg-select" id="pg-grammar"></select>
                </div>
                <div class="pg-field">
                    <label class="pg-label" for="pg-source">Source (.auf) — edit freely</label>
                    <textarea class="pg-area" id="pg-source" spellcheck="false" autocapitalize="off" autocorrect="off"></textarea>
                </div>
                <div class="pg-diag" id="pg-diag">
                    <div class="pg-chips" id="pg-diag-chips">
                        <span class="pg-chip pg-idle">not checked yet</span>
                    </div>
                    <ul class="pg-diag-list" id="pg-diag-list" hidden></ul>
                </div>
            </div>
        </div>

        <div class="pg-box">
            <div class="pg-box-head">
                <h2 class="pg-box-title">Decode</h2>
                <p class="pg-box-note" id="pg-cache-note"></p>
            </div>
            <div class="pg-box-body">
                <div class="pg-field">
                    <label class="pg-label" for="pg-prompt">Prompt</label>
                    <input class="pg-input" id="pg-prompt" type="text" value="Write a C function int add(int a, int b) that returns a plus b. Reply with C code only, no Markdown." aria-describedby="pg-prompt-note">
                    <p class="pg-hint" id="pg-prompt-note">The model sees this prompt, not the grammar source. Name the language and any special syntax. Grammar acceptance does not prove the answer follows your request.</p>
                </div>
                <div class="pg-field pg-row">
                    <span>
                        <label class="pg-label" for="pg-seed">Seed</label>
                        <input class="pg-input" id="pg-seed" type="number" value="7" min="0" step="1">
                    </span>
                    <span>
                        <label class="pg-label" for="pg-max">Max tokens</label>
                        <input class="pg-input" id="pg-max" type="number" value="32" min="1" step="1">
                    </span>
                    <span>
                        <label class="pg-label" for="pg-think-budget">Thinking budget</label>
                        <input class="pg-input" id="pg-think-budget" type="number" min="0" step="64">
                    </span>
                    <span>
                        <label class="pg-label" for="pg-temp">Temperature</label>
                        <input class="pg-input" id="pg-temp" type="text" value="0.0" readonly disabled>
                    </span>
                </div>
                <p class="pg-hint">Temperature is fixed at zero. That is what makes a run
                reproducible and exactly cacheable — yours and everyone else's.</p>
                <p class="pg-hint"><strong>Thinking budget</strong> belongs to the mixed arm
                alone, and is separate from max tokens on purpose: max tokens is sized for a
                program. With <code>0</code>, the channel is closed without generating
                reasoning. If the model does not close its own thought within the budget,
                the channel is closed <em>for</em> it; the result labels that intervention.
                A typed answer is not proof that it answers your prompt.</p>

                <div class="pg-actions">
                    <button class="pg-btn" id="pg-run" disabled>Run all three arms</button>
                    <button class="pg-btn pg-btn-ghost" id="pg-check" disabled>Check grammar</button>
                    <p class="pg-hint" id="pg-status" role="status" aria-live="polite"></p>
                </div>

                <div class="pg-field" style="margin-top: 1.25rem;">
                    <label class="pg-label">Recorded runs — local replay after loading</label>
                    <div class="pg-runs" id="pg-fixtures">
                        <span class="pg-hint">connect to load recorded runs</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div style="margin-top: 2rem;">
        <div class="pg-box-head" style="border: 1px solid var(--rule);">
            <h2 class="pg-box-title">Result</h2>
            <p class="pg-box-note" id="pg-result-note">nothing run yet</p>
        </div>
        <div style="border: 1px solid var(--rule); border-top: 0; padding: 1rem;">
            <div class="pg-arms">
                <div class="pg-arm">
                    <div class="pg-arm-head">
                        <p class="pg-arm-name">Unconstrained</p>
                        <p class="pg-arm-sub">the same model, the same seed, nothing in its way</p>
                    </div>
                    <div class="pg-arm-body" id="pg-arm-unconstrained"></div>
                </div>
                <div class="pg-arm">
                    <div class="pg-arm-head">
                        <p class="pg-arm-name">Constrained</p>
                        <p class="pg-arm-sub">every token checked against the grammar — including the first</p>
                    </div>
                    <div class="pg-arm-body" id="pg-arm-constrained"></div>
                </div>
                <div class="pg-arm pg-arm-lead">
                    <div class="pg-arm-head">
                        <p class="pg-arm-name">Mixed</p>
                        <p class="pg-arm-sub">reason freely first, then emit under the grammar</p>
                    </div>
                    <div class="pg-arm-body" id="pg-arm-mixed"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="pg-note" style="margin-top: 3rem;">
        <h2 class="pg-box-title" style="margin-bottom: 0.75rem;">Reading the telemetry honestly</h2>
        <p>The vLLM backend records token IDs but no retry counts or entropy.
        Empty telemetry means unavailable, not zero. Under greedy decoding it
        checks candidates in descending-logit order until the grammar admits
        one; other sampling temperatures require a full mask.</p>
        <p>Older p7 replay fixtures may record <strong>retries</strong> and
        <strong>entropy after</strong> in bits. Those describe a retry sampler:
        entropy after removes only refused candidates, not every invalid token.
        It is an upper bound and can exceed entropy before. Do not compare it
        to the entropy of a full grammar mask.</p>
        <p><strong><code>no_valid</code></strong> means the decoder found no
        admissible finite-logit token. On vLLM the search covers every finite
        candidate; on p7's retry sampler it stops at a retry ceiling. Neither
        outcome proves that the grammar has no continuation.</p>
        <p><strong>Why there is a third arm.</strong> The mixed arm opens a
        reasoning channel, lets the model think without a grammar, and then
        constrains the answer. Its answer prompt includes the selected thought
        tokens, so it is not an independent second answer. The reasoning is
        shown separately and only the program is graded. On vLLM this changes
        chat framing as well as where the mask applies; the pair explicitly
        disables thinking, while the mixed arm enables it.</p>
        <p><strong><code>think_closed</code></strong> reports whether the model
        ended its own reasoning. If not, <strong><code>think_forced_close</code></strong>
        records the inserted boundary, including when the thinking budget is zero.
        That intervention is visible even when the answer is useful. Neither
        flag proves or disproves that the answer follows your request.</p>
        <p>A run marked <strong>synthetic</strong> is display data for the shape of
        the format. Its numbers are not measurements and are labelled wherever
        they appear.</p>
    </div>
</div>

<script src="/static/js/wirt-playground.js" defer></script>
