<?data from="data/jobs/$slug.mdx" as="job"?>

<?style?>
main {
    background-image: url('/static/images/catacombs-job-post.webp');
    background-size: cover;
    background-position: top center;
    background-repeat: no-repeat;
}
main .hero {
    background: transparent;
}
main .hero::before {
    display: none;
}
.hero, .hero *, .prose-shell, .prose-shell * {
    font-family: var(--font-typewriter) !important;
}
<?/style?>

<?use id="prose-page"?>
    <?label?>Open Role<?/label?>
    <?title from="$job.title"/?>
    <?description from="$job.subtitle"/?>
    <?meta?>$job.team · $job.location · $job.employmentType<?/meta?>
    <?block slot="content"?>
        $job.body
        <p><a class="btn btn-primary" href="$job.applyUrl">Apply for this role</a></p>
    </?block?>
</?use?>
