<?data from="data/posts" as="posts"?>
<?sort over="posts" by="publishDate" order="desc" as="posts"?>

<?style?>
main {
    background-image: url('/static/images/catacombs-blog.webp');
    background-size: cover;
    background-position: top center;
    background-repeat: no-repeat;
}
main .hero {
    background: transparent;
}
main .hero::before {
    display: none;
}
.blog-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 100rem;
    margin: 0 auto;
    padding: 0 2rem;
}
.blog-section {
    padding: 4rem 0 5rem;
}
.blog-contribute {
    max-width: 48rem;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
    border-top: 1px solid var(--border);
}
.blog-contribute-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--text-heading);
    margin: 0 0 0.5rem;
}
.blog-contribute-text {
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
}
<?/style?>

<?use id="hero-cmp"?>
    <?label?>Research notes<?/label?>
    <?title?>Research notes and articles<?/title?>
</?use?>

<section class="section blog-section">

    <div class="blog-list">
        <?map over="posts" as="post"?>
        <?use id="post-row"?>
            <?slug from="$post.slug"?>
            <?publish-date from="$post.publishDate"?>
            <?author from="$post.author"?>
            <?title from="$post.title"?>
            <?excerpt from="$post.excerpt"?>
            <?image from="$post.image"?>
            <?block slot="tags"?>
                <?if cond="$post.tags"?>
                <div class="blog-row-tags">
                    <?map over="$post.tags" as="tag"?><span class="blog-row-tag">$tag</span><?/map?>
                </div>
                <?/if?>
            <?/block?>
        </?use?>
        <?/map?>
    </div>
</section>

<section class="blog-contribute cloud">
    <h2 class="blog-contribute-title">Wanna contribute</h2>
    <p class="blog-contribute-text">Posts are data. Add an <code>.mdx</code> file under <code>data/posts/</code> and open a pull request on <a href="https://github.com/Unsuspicious-Industries/usi" target="_blank" rel="noopener">Unsuspicious-Industries/usi</a>.</p>
</section>
