<?style?>
main {
    background-image: url('/static/images/catacombs-about.webp');
    background-size: cover;
    background-position: top center;
    background-repeat: no-repeat;
}
main .hero {
    background: transparent;
}
main .hero::before {
    display: none;
}
.team-sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    font-weight: 700;
    margin: 0 0 1.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
}
.team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 1.5rem;
}
@media (max-width: 768px) { .team-grid { grid-template-columns: 1fr; } }
.collabs {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 3rem;
}
@media (max-width: 768px) { .collabs { grid-template-columns: 1fr; } }
<?/style?>

<?use id="hero-cmp"?>
    <?title?>About Us<?/title?>
    <?description?>Advancing human knowledge through stochastic epistemology.<?/description?>
</?use?>


<?use id="short-quote-cmp"?>
    <?text?>Not all who wander are lost<?/text?>
    <?author?>J.R.R. Tolkien<?/author?>
    <?work?>The Fellowship of the Ring<?/work?>
</?use?>

<?data from="data/people" as="people"?>
<?use id="section-cmp"?>
    <?block slot="content"?>
        <?use id="section-header"?>
            <?label?>The people<?/label?>
            <?title?>Who we are<?/title?>
            <?subtitle?>A small collective.<?/subtitle?>
        </?use?>

        <p class="team-sub">USI members</p>
        <div class="team-grid">
            <?map over="people" as="person"?>
            <?use id="member-card"?>
                <?initials from="$person.initials"?>
                <?name from="$person.name"?>
                <?role from="$person.role"?>
                <?bio from="$person.bio"?>
                <?website from="$person.website"?>
            </?use?>
            <?/map?>
        </div>
    </?block?>
</?use?>

<?use id="section-cmp"?>
    <?block slot="content"?>
        <div class="cloud">
            <?use id="section-header"?>
                <?title?>Collaborations<?/title?>
            </?use?>
            <div class="collabs">
                <?use id="collab-card"?>
                    <?image?>/static/images/mediapart.svg<?/image?>
                    <?alt?>Mediapart<?/alt?>
                    <?name?>Mediapart<?/name?>
                    <?text?>Technical consulting for an independent French investigative newspaper.<?/text?>
                </?use?>
                <?use id="collab-card"?>
                    <?image?>/static/images/schirn.svg<?/image?>
                    <?alt?>SCHIRN Kunsthalle Frankfurt<?/alt?>
                    <?name?>SCHIRN Kunsthalle Frankfurt<?/name?>
                    <?text?>Development work for <em>Holy Slop!</em>, on our SLOP experiments.<?/text?>
                </?use?>
            </div>
        </div>
    </?block?>
</?use?>
