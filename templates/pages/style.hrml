<?style?>
main {
    background-image: url('/static/images/catacombs-style.webp');
    background-size: cover;
    background-position: top center;
    background-repeat: no-repeat;
}
main .hero {
    background: transparent;
}
main .hero::before {
    display: none;
}
.style-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2rem;
}
<?/style?>

<?use id="prose-page"?>
    <?label?>Visual identity<?/label?>
    <?title?>Style<?/title?>
    <?block slot="content"?>
        <h2>Roles</h2>
        <div class="style-grid">
            <?use id="style-swatch" token="bg-page" name="background" value="$globals.bg_page"/>
            <?use id="style-swatch" token="bg-section" name="surface" value="$globals.bg_section"/>
            <?use id="style-swatch" token="text-heading" name="heading" value="$globals.text_heading"/>
            <?use id="style-swatch" token="text-default" name="body" value="$globals.text_default"/>
            <?use id="style-swatch" token="text-muted" name="muted" value="$globals.text_muted"/>
            <?use id="style-swatch" token="border" name="rule" value="$globals.border"/>
            <?use id="style-swatch" token="accent" name="accent" value="$globals.accent"/>
            <?use id="style-swatch" token="accent" name="on accent" value="$globals.on_accent" sample="accent"/>
            <?use id="style-swatch" token="ok" name="ok" value="$globals.ok"/>
            <?use id="style-swatch" token="warn" name="warn" value="$globals.warn"/>
            <?use id="style-swatch" token="bad" name="bad" value="$globals.bad"/>
        </div>
    </?block?>
</?use?>
