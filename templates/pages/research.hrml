<?block slot="head"?><?title value="Research · USI"?><?meta name="description" content="Formal tools, language models and diffusion models: AUFBAU, KARL and SLOP, with publications."?><?og name="title" content="Research · Unsuspicious Industries"?><?/block?>
<?block slot="content"?>
<?data from="data/projects" as="projects"?>
<?sort over="projects" by="order" as="projects"?>
<?data from="data/publications" as="publications"?>
<?sort over="publications" by="order" as="publications"?>

<?style?>
.feature-anchor { scroll-margin-top: 96px; }
@media (max-width: 768px) { .feature-anchor { scroll-margin-top: 84px; } }
<?/style?>

<?use id="hero-cmp"?>
    <?label?>Research<?/label?>
    <?title?> Studying complex systems with <?accent?>formal tools<?/accent?> and <?accent?>weird ideas<?/accent?>.<?/title?>
</?use?>

<?map over="projects" as="p"?>
<?if cond="$p.section == research"?>
<div id="$p.id" class="feature-anchor">
<?use id="project-feature" pid="$p.id" name="$p.name" icon="$p.icon" eyebrow="$p.eyebrow" tagline="$p.tagline" status="$p.status" meta="$p.meta" caveat="$p.caveat" made="$p.made_with" repro="$p.repro"?>
    <?block slot="prose"?>$p.body<?/block?>
</?use?>
</div>
<?/if?>
<?/map?>

<?use id="section-cmp"?>
    <?block slot="content"?>
        <?use id="section-header"?>
            <?title?>Publications<?/title?>
        </?use?>
        <div class="pubs">
            <?map over="publications" as="pub"?>
            <?use id="publication"?>
                <?status from="$pub.status"?>
                <?title from="$pub.title"?>
                <?authors from="$pub.authors"?>
                <?venue from="$pub.venue"?>
                <?block slot="logos"?>
                    <?for in="l in pub.logos"?>
                    <a href="$l.href" target="_blank" rel="noopener"><img src="$l.src" alt="$l.alt"></a>
                    <?/for?>
                <?/block?>
                <?block slot="meta"?>
                    <?for in="m in pub.meta"?>
                    <span><?if cond="$m.href"?><a href="$m.href" target="_blank" rel="noopener">$m.text</a><?else?>$m.text<?/if?></span>
                    <?/for?>
                <?/block?>
            </?use?>
            <?/map?>
        </div>
    <?/block?>
</?use?>
<?/block?>
