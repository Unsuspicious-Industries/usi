<?use id="hero-cmp"?>
    <?label?>Services<?/label?>
    <?title?>Consulting & Collaboration<?/title?>
    <?description?>We provide technical consulting and research collaboration.<?/description?>
</?use?>

<?use id="section-cmp"?>
    <?block slot="content"?>
        <?use id="section-header"?>
            <?title?>What we offer<?/title?>
            <?subtitle?>Services cover formal methods, software verification and institutional research collaboration.<?/subtitle?>
        </?use?>
        <?use id="card-grid"?>
            <?block slot="content"?>
                <?use id="card-cmp"?>
                    <?href?>/contact<?/href?>
                    <?icon?>brain<?/icon?>
                    <?title?>Consulting<?/title?>
                    <?text?>Consulting on formal methods, type theory, compiler design, ML infrastructure and distributed systems.<?/text?>
                </?use?>
                <?use id="card-cmp"?>
                    <?href?>/contact<?/href?>
                    <?icon?>flask<?/icon?>
                    <?title?>Institutional collaboration<?/title?>
                    <?text?>We collaborate on research and development with universities, laboratories and cultural institutions. We design experiments, co-author papers and build software tools.<?/text?>
                </?use?>
                <?use id="card-cmp"?>
                    <?href?>/contact<?/href?>
                    <?icon?>check<?/icon?>
                    <?title?>Verification<?/title?>
                    <?text?>Verification of software and hardware using theorem provers, model checkers and domain-specific formal tools.<?/text?>
                </?use?>
            </?block?>
        </?use?>
    </?block?>
</?use?>

<?use id="section-cmp"?>
    <?block slot="content"?>
        <?use id="section-header"?>
            <?label?>Selected work<?/label?>
            <?title?>Selected work<?/title?>
        </?use?>
        <?use id="card-grid"?>
            <?cols?>2<?/cols?>
            <?block slot="content"?>
                <?use id="card-cmp"?>
                    <?image?>/static/images/schirn.svg<?/image?>
                    <?title?>SCHIRN Kunsthalle, Frankfurt<?/title?>
                    <?text?>Development work for a SCHIRN exhibition, based on our <a href="https://github.com/Unsuspicious-Industries/slop"><strong>SLOP</strong></a> experiments on latent biases and imagery in diffusion models.<?/text?>
                </?use?>
                <?use id="card-cmp"?>
                    <?image?>/static/images/mediapart.svg<?/image?>
                    <?title?>Mediapart<?/title?>
                    <?text?>Technical consulting for Mediapart, an independent French investigative newspaper.<?/text?>
                </?use?>
            </?block?>
        </?use?>
    </?block?>
</?use?>

<?use id="cta-section"?>
    <?title?>Get in touch<?/title?>
    <?subtitle?>Describe your project or institution.<?/subtitle?>
    <?primary?>Contact Us<?/primary?>
    <?primary-href?>/contact<?/primary-href?>
</?use?>
