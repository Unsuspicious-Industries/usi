                                <?/block?>
                            </?use?>
                        </div>
                    <?/block?>
                                    </?use?>
                <?use id="card-cmp"?>
                    <?icon?>cpu<?/icon?>
                    <?title?>Axiomatic Elaboration team<?/title?>
                    <?text?>
                        Research on formal approaches to ethics and rational thought.
                    <?/text?>
                    <?quote-text?>Ethics and æsthetics are one<?/quote-text?>
