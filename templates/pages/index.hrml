                                <?/block?>
                            </?use?>
                        </div>
                    <?/block?>
                                    </?use?>
                <?use id="card-cmp"?>
                    <?icon?>cpu<?/icon?>
                    <?title?>Industrial Infrastructure<?/title?>
                    <?text?>Runtime and transport infrastructure for large-scale computation.<?/text?>
                    <?block slot="work"?>
                        <div class="card-previews">
