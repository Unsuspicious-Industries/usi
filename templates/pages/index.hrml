<?style?>
/* Page ground: one section of the catacombs survey. The hero drops its own
   fill so the map reads behind it. */
main {
    background-image: url('/static/images/catacombs-index.webp');
    background-size: cover;
    background-position: top center;
    background-repeat: no-repeat;
}
main .hero {
    background: transparent;
}
main .hero::before {
    display: none;
}

/* A department card's evidence row: one compact graphic per artifact, plus a
   named link. No card is an anchor; the link is the artifact. */
.card-previews {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
}
.card-preview {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--border);
    background: var(--bg-section);
    text-decoration: none;
    color: inherit;
}
a.card-preview:hover {
    border-color: var(--accent);
}
a.card-preview:hover .card-preview-name {
    text-decoration: underline;
}
.card-preview-media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 2rem;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--bg-page);
    border: 1px solid var(--border);
    color: var(--accent);
}
.card-preview-media .project-icon {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
}
.card-preview-body {
    min-width: 0;
}
.card-preview-name {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.card-preview-note {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.66rem;
    line-height: 1.4;
    color: var(--text-muted);
}
.card-preview-arrow {
    margin-left: auto;
    padding-left: 0.5rem;
    color: var(--accent);
    font-size: 0.8rem;
}
.card-preview.is-pending {
    border-style: dashed;
}
.card-preview.is-pending .card-preview-name {
    color: var(--text-muted);
}
<?/style?>

<?component id="card-preview"?>
<?bind var="href"/?>
<?bind var="name"/?>
<?bind var="note"/?>
<?if cond="$href"?>
    <a class="card-preview" href="$href">
        <span class="card-preview-media"><?slot id="media"?></span>
        <span class="card-preview-body">
            <span class="card-preview-name">$name</span>
            <?if cond="$note"?>
                <span class="card-preview-note">$note</span>
            <?/if?>
        </span>
        <span class="card-preview-arrow" aria-hidden="true">↗</span>
    </a>
<?else?>
    <!-- No verified public URL: the row names the artifact without a
         destination rather than inventing one. -->
    <span class="card-preview is-pending">
        <span class="card-preview-media"><?slot id="media"?></span>
        <span class="card-preview-body">
            <span class="card-preview-name">$name</span>
            <?if cond="$note"?>
                <span class="card-preview-note">$note</span>
            <?/if?>
        </span>
    </span>
<?/if?>
<?/component?>

<?use id="hero-cmp"?>
    <?label?>Research at the boundaries of sense<?/label?>
    <?title?>Formal Systems with <span class="blur text-accent">blurred</span> edges<?/title?>
    <?description?><?accent?>Unsuspicious Industries</?accent?> is a research collective working across computer science, critical theory and the natural sciences.<?/description?>
</?use?>

<?use id="section-cmp"?>
    <?block slot="content"?>
        <?use id="card-grid"?>
            <?cols?>2<?/cols?>
            <?block slot="content"?>
                <?use id="card-cmp"?>
                    <?icon?>code<?/icon?>
                    <?title?>Dynamic & Formal Systems lab<?/title?>
                    <?text?>Research on proof systems, strong normalization and applied type theory.<?/text?>
                    <?quote-text?>philosophy courses should teach how to use proof assistants<?/quote-text?>
                    <?quote-author?>Alcuin<?/quote-author?>
                    <?quote-work?>𝕏, @scheminglunatic<?/quote-work?>
                    <?block slot="work"?>
                        <div class="card-previews">
                            <?use id="card-preview"?>
                                <?href?>/research#karl<?/href?>
                                <?name?>KARL<?/name?>
                                <?note?>Revolutionary-text corpus & model<?/note?>
                                <?block slot="media"?>
                                    <?use id="project-icon"?><?id?>karl<?/id?></?use?>
                                <?/block?>
                            </?use?>
                            <?use id="card-preview"?>
                                <?href?>/tools#remblais<?/href?>
                                <?name?>Remblais<?/name?>
