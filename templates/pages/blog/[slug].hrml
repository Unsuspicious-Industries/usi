<?block slot="head"?><?data from="data/posts/$slug.mdx" as="post"?><?title value="$post.title · Unsuspicious Industries"?><?meta name="description" content="$post.excerpt"?><?og name="title" content="$post.title · Unsuspicious Industries"?><?/block?>
<?block slot="content"?>
<?style?>
main {
    background-image: url('/static/images/catacombs-blog-post.webp');
    background-size: cover;
    background-position: top center;
    background-repeat: no-repeat;
}
main .hero {
    background: transparent;
}
main .hero::before {
    display: none;
}
<?/style?>

<?data from="data/posts/$slug.mdx" as="post"?>

<?use id="prose-page"?>
    <?label?>Research Note<?/label?>
    <?title from="$post.title"/?>
    <?description from="$post.excerpt"/?>
    <?meta?>$post.author · $post.publishDate · $post.status<?/meta?>
    <?block slot="content"?>$post.body</?block?>
</?use?>
<?/block?>
