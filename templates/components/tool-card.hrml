<?component id="tool-card"?>
<?bind var="anchor"/>
<?bind var="title"/>
<?bind var="mark"/>
<?bind var="project"/>
<?bind var="kind"/>
<?bind var="link"/>
<?bind var="link-label"/>
<?bind var="link-text"/>
<?bind var="text"/>
<?style?>
.tool {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--bg-page);
    border: 1px solid var(--border);
}
.tool-demo {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    height: 18rem;
    min-width: 0;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-page));
    border-bottom: 1px solid var(--border);
}
/* A figure authored by the call site becomes a layout pass-through, so its
   figcaption and body keep taking part in the demo's flex column. */
.tool-demo > figure {
    display: contents;
    margin: 0;
}
.tool-caption {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
}
.tool-code {
    min-width: 0;
    overflow-x: auto;
    line-height: 1.6;
}
.tool-code code {
    display: block;
    padding: 0;
    background: transparent;
    font-size: 0.78rem;
}
.tool-code .syntax { color: var(--accent); }
.tool-check {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
}
.tool-check code { background: transparent; padding: 0; }
.tool-check span {
    padding: 0.2rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--bad) 35%, var(--border));
    color: var(--bad);
    font-size: 0.65rem;
}
.tool-render {
    padding: 1rem 1.25rem;
    background: var(--bg-page);
    border-left: 3px solid var(--accent);
}
.tool-sources {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
}
.tool-sources .tool-caption { margin-bottom: 0.5rem; }
.tool-sources .tool-code code { font-size: 0.7rem; }
.tool-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.65rem;
}
.tool-pair {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--accent);
    text-align: center;
    line-height: 1.3;
}
.tool-results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
}
.tool-result {
    padding: 0.75rem 1rem;
    background: var(--bg-page);
    border-top: 2px solid var(--accent);
}
.tool-result dt {
    font-size: 0.65rem;
    color: var(--text-muted);
}
.tool-result dd {
    margin-top: 0.3rem;
    font-size: 1.65rem;
    color: var(--text-heading);
    line-height: 1.2;
}
.tool-note {
    font-size: 0.65rem;
    line-height: 1.5;
    color: var(--text-muted);
}
.tool-body {
    flex: 1;
    padding: 1.5rem;
}
.tool-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
}
.tool-head .project-icon {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--accent);
}
.tool-mark {
    height: 1.75rem;
    width: auto;
    flex-shrink: 0;
}
.tool-title {
    font-size: 1.5rem;
    color: var(--text-heading);
    line-height: 1.35;
}
.tool-text {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.7;
}
.tool-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
}
.tool-kind {
    font-size: 0.65rem;
    color: var(--text-muted);
}
.tool-link {
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
}
.tool-link:hover { text-decoration: underline; }
.tool-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
}
@media (max-width: 768px) {
    .tool-demo { height: auto; min-height: 16rem; padding: 1.25rem; }
    .tool-sources { grid-template-columns: minmax(0, 1fr); }
    .tool-body { padding: 1.25rem; }
    .tool-actions { margin: 0 1.25rem; }
    .tool-result { padding: 0.75rem; }
    .tool-result dd { font-size: 1.4rem; }
}
<?/style?>
<article class="tool" aria-labelledby="$anchor">
    <div class="tool-demo"><?slot id="demo"?></div>
    <div class="tool-body">
        <div class="tool-head">
            <?if cond="$project"?>
                <?use id="project-icon"?><?id from="$project"?></?use?>
            <?else?>
                <?if cond="$mark"?>
                <img class="tool-mark" src="$mark" alt="" width="32" height="32">
                <?/if?>
            <?/if?>
            <h2 class="tool-title" id="$anchor">$title</h2>
        </div>
        <p class="tool-text">$text</p>
    </div>
    <div class="tool-actions">
        <span class="tool-kind">$kind</span>
        <a class="tool-link" href="$link" target="_blank" rel="noopener" aria-label="$link-label">$link-text</a>
    </div>
</article>
<?/component?>
