<?component id="demo"?>
<?style?>
.demo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-page));
    border: 1px solid var(--border);
}
.demo > figure { display: contents; margin: 0; }
.tool-caption {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
}
.tool-code {
    min-width: 0;
    overflow-x: auto;
    line-height: 1.6;
}
.tool-code code {
    display: block;
    padding: 0;
    background: transparent;
    font-size: 0.78rem;
}
.tool-code .syntax { color: var(--accent); }
.tool-check {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
}
.tool-check code { background: transparent; padding: 0; }
.tool-check span {
    padding: 0.2rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--bad) 35%, var(--border));
    color: var(--bad);
    font-size: 0.65rem;
}
.tool-render {
    padding: 1rem 1.25rem;
    background: var(--bg-page);
    border-left: 3px solid var(--accent);
}
.tool-sources {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
}
.tool-sources .tool-caption { margin-bottom: 0.5rem; }
.tool-sources .tool-code code { font-size: 0.7rem; }
.tool-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.65rem;
}
.tool-pair {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--accent);
    text-align: center;
    line-height: 1.3;
}
.tool-results {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
}
.tool-result {
    padding: 0.75rem 1rem;
    background: var(--bg-page);
    border-top: 2px solid var(--accent);
}
.tool-result dt {
    font-size: 0.65rem;
    color: var(--text-muted);
}
.tool-result dd {
    margin-top: 0.3rem;
    font-size: 1.65rem;
    color: var(--text-heading);
    line-height: 1.2;
}
.tool-note {
    font-size: 0.65rem;
    line-height: 1.5;
    color: var(--text-muted);
}
@media (max-width: 768px) {
    .tool-sources { grid-template-columns: minmax(0, 1fr); }
    .tool-result { padding: 0.75rem; }
    .tool-result dd { font-size: 1.4rem; }
}
<?/style?>
<div class="demo"><?slot id="content"?></div>
<?/component?>
