<?component id="publication"?>
<?bind var="status"/?>
<?bind var="title"/?>
<?bind var="authors"/?>
<?bind var="venue"/?>
<?style?>
.pubs {
    max-width: 80rem;
    margin: 0 auto;
    display: grid;
    gap: 1.5rem;
}
.pub {
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    padding: 1.5rem 1.75rem;
    background: var(--bg-page);
}
.pub-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
}
.pub-status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-weight: 700;
    margin: 0 0 0.5rem;
}
.pub-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--text-heading);
    margin: 0;
}
.pub-authors { color: var(--text-default); margin: 0 0 0.35rem; }
.pub-venue { color: var(--text-muted); margin: 0 0 1rem; line-height: 1.6; }
.pub-venue em { color: var(--text-default); font-style: normal; }
.pub-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
}
.pub-logos img {
    height: 1.75rem;
    width: auto;
    display: block;
}
/* The ACM mark is a square diamond and reads small at the wordmark height. */
.pub-logos img[src$="acm.svg"] { height: 3.4rem; }
.pub-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    padding-top: 1rem;
    border-top: 1px solid var(--border);
}
.pub-meta a { color: var(--accent); text-decoration: none; }
.pub-meta a:hover { text-decoration: underline; }
@media (max-width: 768px) {
    .pub-head { flex-direction: column; }
    .pub-logos { align-self: flex-start; max-width: 100%; }
    .pub-logos img { max-width: 100%; }
}
<?/style?>
<article class="pub">
    <div class="pub-head">
        <div>
            <p class="pub-status">$status</p>
            <h3 class="pub-title">$title</h3>
        </div>
        <div class="pub-logos"><?slot id="logos"?></div>
    </div>
    <?if cond="$authors"?>
    <p class="pub-authors">$authors</p>
    <?/if?>
    <p class="pub-venue">$venue</p>
    <div class="pub-meta"><?slot id="meta"?></div>
</article>
<?/component?>
