<?component id="footer-cmp"?>
<?style?>
.site-footer {
    background: var(--bg-section);
    border-top: 1px solid var(--border);
}
.footer-grid {
    padding: 2.5rem 3rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
}
.footer-brand-col {
}
.footer-brand {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--primary);
    margin-bottom: 0.75rem;
}
.footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
}
.footer-links a {
    color: var(--text-muted);
    font-size: 0.875rem;
}
.footer-links a:hover {
    color: var(--text-default);
    text-decoration: underline;
}
.footer-social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}
.footer-social a {
    color: var(--text-muted);
    display: flex;
    align-items: center;
    transition: color 0.15s;
}
.footer-social a:hover {
    color: var(--accent);
}
.footer-social svg {
    width: 1.125rem;
    height: 1.125rem;
}
.footer-meta-col {
    width: 100%;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
}
.footer-copyright {
    color: var(--text-muted);
    font-size: 0.875rem;
}
@media (max-width: 768px) {
    .footer-grid {
        padding: 1.5rem 1rem 1rem;
        flex-direction: column;
        align-items: stretch;
    }
    .footer-brand-col {
        margin-bottom: 0;
    }
    .footer-social {
        margin-left: 0;
        justify-content: flex-start;
    }
    .footer-links {
        gap: 0.75rem;
    }
    .footer-meta-col {
        justify-content: space-between;
    }
}
<?/style?>
<footer class="site-footer">
    <div class="footer-grid">
        <div class="footer-brand-col">
            <div class="footer-brand">$site_name</div>
            <div class="footer-links">
                <a href="/about">About</a>
                <a href="/contact">Contact</a>
                <a href="/blog">Blog</a>
                <a href="/style">Style</a>
                <a href="https://ent.unsuspicious.org">ENT</a>
            </div>
        </div>
        <div class="footer-social">
            <a href="https://github.com/Unsuspicious-Industries" aria-label="GitHub">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-brand-github"/></svg>
            </a>
            <a href="https://x.com/unsuspiciousind" aria-label="X / Twitter">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-brand-twitter"/></svg>
            </a>
            <a href="https://linkedin.com/company/unsuspicious" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-brand-linkedin"/></svg>
            </a>
            <a href="https://huggingface.co/dfslab" aria-label="Hugging Face">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#icon-brand-huggingface"/></svg>
            </a>
        </div>
        <div class="footer-meta-col">
            <div class="footer-copyright">
                Established 2024 · All right to the people.
            </div>
            <a href="/ethics" class="nav-link">Ethics policy</a>
        </div>
    </div>
</footer>
<?/component?>
