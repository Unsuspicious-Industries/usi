<?component id="card-body"?>
<?bind var="icon"/?>
<?bind var="glyph"/?>
<?bind var="image"/?>
<?bind var="title"/?>
<?bind var="text"/?>
<?bind var="quote-text"/?>
<?bind var="quote-author"/?>
<?bind var="quote-work"/?>
<?style?>
.card {
    position: relative;
    background: var(--bg-page);
    border: 1px solid var(--border);
    padding: 1.75rem 1.5rem 1.5rem;
    overflow: hidden;
}
/* Sud-Est livery in the site's blue: a body band over a window band at the
   head, and a grey skirt at the foot. */
.card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 0.625rem;
    background: linear-gradient(
        var(--accent) 0 0.375rem,
        var(--bg-section) 0.375rem 0.625rem
    );
}
.card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 0.375rem;
    background: var(--bg-section);
}
.card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
}
.card-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--accent);
    margin-left: auto;
    flex-shrink: 0;
}
.card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-heading);
}
.card-text {
    color: var(--text-muted);
    font-size: 0.9375rem;
}
.card-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}
.card-quote {
    margin-top: 1rem;
    padding: 1rem 1rem 1rem 1.75rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-section);
    position: relative;
}
.card-quote::before {
    content: '\201C';
    position: absolute;
    top: -0.25rem;
    left: 0.2rem;
    font-family: var(--font-serif);
    font-size: 3rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.25;
}
.card-quote-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--text-heading);
    line-height: 1.65;
    margin-bottom: 0.6rem;
}
.card-quote-attribution {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
}
.card-quote-author {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--primary);
}
.card-quote-work {
    font-size: 0.6875rem;
    color: var(--text-muted);
}
.card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.card-link .card {
    height: 100%;
}
.card-link:hover {
    transform: translateY(-2px);
}
.card-link:hover .card {
    box-shadow: 0 8px 16px color-mix(in srgb, var(--text-default) 10%, transparent);
}
.card-icon .icon-sm {
    color: var(--accent);
    display: block;
}
.card-image {
    width: 100%;
    height: 4rem;
    object-fit: contain;
    object-position: left;
    margin-bottom: 0.75rem;
}
<?/style?>
<div class="card">
    <?if cond="$image"?>
        <img src="$image" class="card-image" alt="" loading="lazy" decoding="async" />
    <?/if?>
    <div class="card-head">
        <?if cond="$title"?>
            <h3 class="card-title">$title</h3>
        <?/if?>
        <?if cond="$icon"?>
            <div class="card-icon">
                <svg class="icon-sm"><use href="#icon-$icon"/></svg>
            </div>
        <?/if?>
        <?if cond="$glyph"?>
            <div class="card-icon">$glyph</div>
        <?/if?>
    </div>
    <?if cond="$text"?>
        <p class="card-text">$text</p>
    <?/if?>
    <div class="card-work"><?slot id="work"?></?slot?></div>
    <?if cond="$quote-text"?>
        <blockquote class="card-quote">
            <p class="card-quote-text">$quote-text</p>
            <div class="card-quote-attribution">
                <span class="card-quote-author">$quote-author</span>
                <span class="card-quote-work">$quote-work</span>
            </div>
        </blockquote>
    <?/if?>
</div>
<?/component?>

<?component id="card-cmp"?>
<?bind var="href"/?>
<?bind var="icon"/?>
<?bind var="glyph"/?>
<?bind var="image"/?>
<?bind var="title"/?>
<?bind var="text"/?>
<?bind var="quote-text"/?>
<?bind var="quote-author"/?>
<?bind var="quote-work"/?>
<?if cond="$href"?>
    <a href="$href" class="card-link"><?use id="card-body"?>
        <?block slot="work"?><?slot id="work"?></?slot><?/block?>
    </?use?></a>
<?else?>
    <?use id="card-body"?>
        <?block slot="work"?><?slot id="work"?></?slot><?/block?>
    </?use?>
<?/if?>
<?/component?>
