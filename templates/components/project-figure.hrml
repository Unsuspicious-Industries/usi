<?component id="project-figure"?>
<?bind var="pid"/?>
<?bind var="view"/?>
<?if cond="$pid == aufbau"?><?use id="figure-aufbau"?></?use?><?/if?>
<?if cond="$pid == karl"?><?use id="figure-karl"?></?use?><?/if?>
<?if cond="$pid == slop"?><?use id="figure-slop"?></?use?><?/if?>
<?if cond="$pid == slut"?><?use id="figure-slut"?></?use?><?/if?>
<?if cond="$pid == hrml"?><?use id="figure-hrml"?></?use?><?/if?>
<?if cond="$pid == remblais"?><?use id="figure-remblais"?></?use?><?/if?>
<?if cond="$pid == political-alignment"?><?use id="figure-political-alignment"?></?use?><?/if?>
<?if cond="$pid == mpi-rma"?><?if cond="$view == card"?><?use id="figure-mpi-rma-ring"?></?use?><?else?><?use id="figure-mpi-rma"?></?use?><?/if?><?/if?>
<?if cond="$pid == trame"?><?use id="figure-trame"?></?use?><?/if?>
<?if cond="$pid == nixsci"?><?use id="figure-nixsci"?></?use?><?/if?>
<?/component?>
