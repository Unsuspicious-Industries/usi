<?component id="hero-cmp"?>
<?bind var="label"/?>
<?bind var="title"/?>
<?bind var="description"/?>
<?style?>
.hero {
    padding: 3rem 1.5rem 2rem;
    text-align: center;
    background: var(--bg-page);
    position: relative;
    isolation: isolate;
    overflow: clip;
}
.hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(180deg, var(--bg-section) 0%, var(--bg-page) 100%);
    z-index: -1;
}
.hero-content {
    max-width: 68rem;
    margin: 0 auto;
    position: relative;
}
/* The page ground runs under the copy on every page; hold it off with a cloud
   rather than a box. Three soft white fields overlap, so they go opaque where
   they meet (behind the label, title and description) and fade to nothing at
   the edges. */
.hero-content::before {
    content: '';
    position: absolute;
    inset: -3rem -8rem;
    z-index: -1;
    pointer-events: none;
    background:
        radial-gradient(46% 70% at 30% 46%, var(--bg-page) 0%, var(--bg-page) 30%, transparent 88%),
        radial-gradient(52% 78% at 68% 44%, var(--bg-page) 0%, var(--bg-page) 30%, transparent 90%),
        radial-gradient(62% 94% at 50% 56%, var(--bg-page) 0%, var(--bg-page) 40%, transparent 96%);
    filter: blur(22px);
}
.hero-label {
    font-weight: 700;
    color: var(--secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.875rem;
    margin-bottom: 1rem;
}
.hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--secondary);
    line-height: 1.1;
    margin-bottom: 1rem;
}
.hero-title .blur { filter: blur(2px); }
.hero-description {
    font-size: 1.25rem;
    color: var(--text-muted);
    max-width: 48rem;
    margin: 0 auto;
}
.hero-compact {
    padding-bottom: 2.5rem;
}
.page-meta {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}
@media (max-width: 768px) {
    .hero-title {
        font-size: 1.75rem;
    }
}
<?/style?>
<section class="hero">
    <div class="hero-content">
        <?if cond="$label"?>
        <p class="hero-label">$label</p>
        <?/if?>
        <?if cond="$title"?>
        <h1 class="hero-title">$title</h1>
        <?/if?>
        <?if cond="$description"?>
        <p class="hero-description">$description</p>
        <?/if?>
    </div>
</section>
<?/component?>
