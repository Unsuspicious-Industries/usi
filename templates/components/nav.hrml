<?component id="nav-cmp"?>
<?style?>
.site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 0.875rem 2rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 100%;
    box-sizing: border-box;
}
.nav-brand {
    flex-shrink: 0;
}
.nav-logo-img img {
    height: 36px;
    width: auto;
    max-width: 130px;
    display: block;
}
.nav-logo-mobile {
    display: none;
}
.nav-links {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    flex-wrap: wrap;
    justify-content: center;
    flex: 1;
    min-width: 0;
}
.nav-link {
    color: var(--text-default);
    font-size: 1rem;
    padding: 0.5rem 1rem;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
}
.nav-link:hover {
    background: #f3f4f6;
    color: var(--accent);
}
.nav-cta-link {
    flex-shrink: 0;
}
.nav-cta {
    background: var(--accent);
    color: white;
    border-radius: 4px;
}
.nav-cta:hover {
    background: var(--brand-accent-1);
    color: white;
}
.nav-toggle {
    display: none;
}
.nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 24px;
    height: 24px;
    cursor: pointer;
    flex-shrink: 0;
}
.nav-hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--text-default);
    transition: transform 0.2s ease, opacity 0.2s ease;
}
@media (max-width: 768px) {
    .site-nav {
        padding: 0.75rem 1rem;
        gap: 0.75rem;
    }
    .nav-logo-img {
        display: none;
    }
    .nav-logo-mobile {
        display: flex;
        align-items: center;
    }
    .nav-logo-mobile img {
        height: 40px;
        width: 40px;
        display: block;
    }
    .nav-hamburger {
        display: flex;
        align-items: center;
        gap: 6px;
        width: auto;
        height: auto;
    }
    .nav-hamburger span {
        width: 20px;
        height: 3px;
        background: var(--accent);
        border-radius: 1px;
    }
    .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        flex-direction: column;
        padding: 0.5rem 0;
        gap: 0;
        z-index: 99;
    }
    .nav-link {
        font-size: 1rem;
        padding: 0.75rem 1.5rem;
        border-radius: 0;
    }
    .nav-link:hover {
        background: var(--bg-section);
    }
    .nav-cta-link {
        display: block;
        border-top: 1px solid var(--border);
        margin-top: 0.25rem;
        padding-top: 0.75rem;
    }
    .nav-toggle:checked ~ .nav-links {
        display: flex;
    }
    .nav-toggle:checked ~ .nav-hamburger span:nth-child(1) {
        transform: translateY(9px) rotate(45deg);
    }
    .nav-toggle:checked ~ .nav-hamburger span:nth-child(2) {
        opacity: 0;
    }
    .nav-toggle:checked ~ .nav-hamburger span:nth-child(3) {
        transform: translateY(-9px) rotate(-45deg);
    }
}
<?/style?>
<nav class="site-nav">
    <div class="nav-brand">
        <a href="/" class="nav-logo-img"><img src="/static/images/usi.png" alt="Unsuspicious Industries"></a>
        <a href="/" class="nav-logo-mobile"><img src="/static/graphics/short.png" alt="USI"></a>
    </div>
    <input type="checkbox" id="nav-toggle" class="nav-toggle">
    <label for="nav-toggle" class="nav-hamburger" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
    </label>
    <div class="nav-links">
        <a href="/product" class="nav-link">Product</a>
        <a href="/dfs" class="nav-link">DFS</a>
        <a href="/services" class="nav-link">Services</a>
        <a href="/jobs" class="nav-link">Jobs</a>
        <a href="/about" class="nav-link">About</a>
        <a href="/blog" class="nav-link">Thoughts</a>
    </div>
    <a href="/contact" class="nav-link nav-cta nav-cta-link">Contact</a>
</nav>
<?/component?>
