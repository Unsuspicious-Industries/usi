<!-- The canonical project identity marks: one monochrome silhouette per named
     project, shared by every USI site instead of redrawn per page.

     A mark is an IDENTITY, not a figure. The labelled diagrams and screenshots
     that explain a project stay where they are and are NOT icons: the SLOP
     bias-field and grid-distillation SVGs, the Remblais morph frames, the
     KARL path figure, the mpi-rma and trame schematics, and the political
     compass chart in unsuspicious.org/static/images/compass.svg (it carries
     axis labels and hexes and turns to mush at 24px). A mark takes the same
     subject down to a silhouette that reads at 16-24px in one colour.

     The ids are the registry's ids; lib/project-icons.nix is the list of which
     projects must exist, and `nix flake check` fails if this sprite and that
     list drift apart. `<?project-icon?>` (project-icon.hrml) is the only thing
     a page should write; it references these symbols by `#project-<id>`.

     Every symbol is a 24x24 viewBox, filled/stroked with `currentColor` and
     carrying no colour literal, no fixed width/height and no <text>, <image>
     or external reference; the check enforces all of that. That is what keeps
     one mark legible on both palettes and at any size.

     This sprite must be in the document for its references to resolve, exactly
     like `icons`; layouts/base.hrml instantiates it once at the end of <body>.
     A site that overrides the layout must add
     `<?use id="project-icons"?></?use?>` once, next to the icons sprite. -->
<?component id="project-icons"?>
<svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
    <!-- AUFBAU — a typing judgment. Γ ⊢ e : τ reduced to the turnstile, the
         judged term, and the type it is checked against. -->
    <symbol id="project-aufbau" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5.5V18.5"/><path d="M5 12h5"/><rect x="11.5" y="8.5" width="4.5" height="7" rx="1" fill="currentColor" stroke="none"/><circle cx="17.8" cy="10" r=".9" fill="currentColor" stroke="none"/><circle cx="17.8" cy="14" r=".9" fill="currentColor" stroke="none"/><path d="M19.3 9h3.2M20.9 9v7"/></symbol>
    <!-- KARL — a corpus of revolutionary press: an open book, distinct from
         the generic closed `icon-book`. -->
    <symbol id="project-karl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.6c-1.8-1.7-4.6-2.2-7.5-1.8v13.6c2.9-.4 5.7.1 7.5 1.8"/><path d="M12 6.6c1.8-1.7 4.6-2.2 7.5-1.8v13.6c-2.9-.4-5.7.1-7.5 1.8"/><path d="M12 6.6v13.6"/></symbol>
    <!-- Remblais — optimal-transport morphing: one square split into the mass
         it keeps and the mass it sends, with a transported density marker. -->
    <symbol id="project-remblais" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="17" height="17" rx="1.5"/><path d="M4.5 19.5V4.5H19.5Z" fill="currentColor" stroke="none"/><path d="M4.5 19.5 19.5 4.5"/><circle cx="15.5" cy="16" r="1.6"/></symbol>
    <!-- SLOP — the latent bias field: nested attractor basins around a core,
         with one prompt trajectory bent in from the open field. -->
    <symbol id="project-slop" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="12" r="6.5"/><circle cx="13.5" cy="12" r="3"/><circle cx="13.5" cy="12" r="1.4" fill="currentColor" stroke="none"/><path d="M2 18q4.5 0 6.6-3.4"/></symbol>
    <!-- Political Alignment — a stylized compass: a ring and a directional
         needle, not the labelled political-compass chart (that chart stays a
         figure in unsuspicious.org). Reads at 16px, and cannot be confused
         with the mpi-rma window. -->
    <symbol id="project-political-alignment" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88Z" fill="currentColor" stroke="none"/></symbol>
    <!-- mpi-rma — one-sided remote-memory access. A put from the sender enters
         a compact memory window; the first slot is occupied. The ring-buffer
         wrap-around cue is dropped: at 24px the old dot-ring read as a generic
         ring, and the arrow into the slots is the part that means RMA. -->
    <symbol id="project-mpi-rma" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="6" width="14.5" height="12" rx="1.5"/><path d="M11.8 6v12M16.6 6v12"/><rect x="8" y="8.4" width="3.2" height="7.2" rx=".5" fill="currentColor" stroke="none"/><path d="M1.5 12H5"/><path d="M7 12l-2.7-1.6v3.2Z" fill="currentColor" stroke="none"/></symbol>
    <!-- trame — a plain weave: warp and weft. Following fr.wikipedia
         "Trame (tissage)", "la trame désigne les fils passés entre les fils
         de chaîne". Three vertical warp threads and two horizontal weft
         threads; each thread is cut where the crossing thread passes over it,
         so the gap is a segment end and never a background-coloured eraser
         (which would vanish on the futurist palette). Not a plain grid: every
         crossing alternates over/under. Butt caps preserve the small crossing
         gaps; rounded caps would extend into the overpassing thread. -->
    <symbol id="project-trame" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="butt" stroke-linejoin="round"><path d="M6 2.5V6.3M6 9.7V21.5"/><path d="M12 2.5V14.3M12 17.7V21.5"/><path d="M18 2.5V6.3M18 9.7V21.5"/><path d="M2.5 8h7.8M13.7 8h7.8"/><path d="M2.5 16h1.8M7.7 16h8.6M19.7 16h1.8"/></symbol>
    <!-- HRML — a markup tag with a component node between the brackets. -->
    <symbol id="project-hrml" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 6 4 12l5.5 6"/><path d="M14.5 6 20 12l-5.5 6"/><rect x="10.5" y="10.5" width="3" height="3" rx=".5" fill="currentColor" stroke="none"/></symbol>
    <!-- SLUT — the isometric cube mark from static/images/slut.svg, its
         face glyphs Σ L M T dropped so the cube survives at 24px, and the
         central dot kept. -->
    <symbol id="project-slut" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9Z"/><path d="M4 7.5 12 12l8-4.5"/><path d="M12 12v9"/><circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/></symbol>
    <!-- Gilles Economics — the class/State contradiction map from
         https://gilles.unsuspicious.org/#lab-graphs (the .topic-map
         topic-diagram). État top, Bourgeoisie bottom-right, Prolétariat
         bottom-left, Petite bourgeoisie as the inner fourth node, and every
         pair in contradiction: the triangle's three sides plus the three
         medians to the interior node. The labelled rectangles become nodes; no
         indicator data is borrowed. -->
    <symbol id="project-gilles-economics" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4 4 19h16Z"/><path d="M12 4v10M4 19l8-5M20 19l-8-5"/><circle cx="12" cy="4" r="1.7" fill="currentColor" stroke="none"/><circle cx="4" cy="19" r="1.7" fill="currentColor" stroke="none"/><circle cx="20" cy="19" r="1.7" fill="currentColor" stroke="none"/><circle cx="12" cy="14" r="1.7" fill="currentColor" stroke="none"/></symbol>
</svg>
<?/component?>
