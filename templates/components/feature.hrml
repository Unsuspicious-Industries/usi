<?component id="feature"?>
<?bind var="eyebrow"/?>
<?bind var="name"/?>
<?bind var="project"/?>
<?bind var="tagline"/?>
<?style?>
/* Infra uses only features, so section-cmp's tree-shaken CSS is absent there.
   Own the section spacing instead of depending on another component's use. */
.feature {
    padding: 2rem 2rem 4rem;
    max-width: 100rem;
    margin: 0 auto;
}
.feature-inner {
    max-width: 80rem;
    margin: 0 auto;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 3rem;
    align-items: start;
}
.feature-header {
    grid-column: 1;
    grid-row: 1;
}
.feature-prose {
    grid-column: 1;
    grid-row: 2;
    min-width: 0;
}
.feature-figure {
    grid-column: 2;
    grid-row: 1 / span 2;
    min-width: 0;
}
.feature-links {
    grid-column: 1 / -1;
    grid-row: 3;
}
.feature-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-weight: 700;
}
.feature-name {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 700;
    color: var(--text-heading);
    line-height: 1;
    margin: 0.5rem 0;
    letter-spacing: 0.02em;
}
.feature-name .project-icon {
    width: 2.25rem;
    height: 2.25rem;
    margin-right: 0.65rem;
    color: var(--accent);
}
.feature-tag {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin: 0 0 2.5rem;
    max-width: 40rem;
}
.feature-prose p {
    color: var(--text-default);
    line-height: 1.75;
    margin: 0 0 1.1rem;
}
.feature-prose accent { font-weight: 600; }
.feature-prose strong { color: var(--text-heading); }
.feature-figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
}
.feature-figure figcaption {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 0.6rem;
    line-height: 1.5;
}
.feature-figure + .feature-figure { margin-top: 1.75rem; }
.feature-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
}
.feature-links a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
}
.feature-links a:hover { border-bottom-color: var(--accent); }
.feature-links .meta { color: var(--text-muted); }
@media (max-width: 768px) {
    .feature { padding: 2rem 1rem; }
}
@media (max-width: 860px) {
    .feature-inner { grid-template-columns: minmax(0, 1fr); }
    .feature-header,
    .feature-prose,
    .feature-figure,
    .feature-links {
        grid-column: 1;
        grid-row: auto;
    }
    .feature-name { font-size: 2.25rem; }
}
<?/style?>
<section class="section feature">
    <div class="feature-inner">
        <div class="feature-header">
            <?if cond="$eyebrow"?>
            <p class="feature-eyebrow">$eyebrow</p>
            <?/if?>
            <?if cond="$name"?>
            <h2 class="feature-name"><?if cond="$project"?><?use id="project-icon"?><?id from="$project"?></?use?><?/if?>$name</h2>
            <?/if?>
            <?if cond="$tagline"?>
            <p class="feature-tag">$tagline</p>
            <?/if?>
        </div>
        <div class="feature-prose"><?slot id="prose"?></div>
        <div class="feature-figure"><?slot id="figure"?></div>
        <div class="feature-links"><?slot id="links"?></div>
    </div>
</section>
<?/component?>
